# --- titkok és helyi környezet: SOHA ne kerüljön GitHubra ---
.env
.env.*
!.env.example

# --- játékos-adatok (a memory mappa a játékos gépén keletkezik, de fejlesztés közben a projektben is) ---
memory/
memory-*/
.dev-userdata/
*.corrupt

# --- az AI-k saját munkakönyvtárai (git worktree; scripts/ai-setup.sh hozza létre) ---
.work/

# --- függőségek, build ---
node_modules/
dist/
out/
release/
.vercel/
*.log

# --- szerkesztők, rendszerfájlok ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
dist-electron/
