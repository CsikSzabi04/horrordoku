{
  "name": "nightdoku",
  "version": "0.0.1",
  "private": true,
  "description": "NIGHTDOKU — horror-gyilkossági logikai rejtvényjáték (webes)",
  "author": "NIGHTDOKU",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "validate:puzzles": "vitest run src/content/puzzles.test.ts",
    "audit": "vitest run src/engine/audit.test.ts",
    "e2e": "node scripts/e2e/classic.mjs && node scripts/e2e/random.mjs && node scripts/e2e/events.mjs && node scripts/e2e/scare.mjs && node scripts/e2e/login.mjs && node scripts/e2e/coop.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0"
  }
}
