# Másold le .env néven, és töltsd ki. A .env NINCS a gitben (.gitignore).
#
# Supabase: Project Settings -> API (vagy a Connect ablak).
# Csak a PUBLIKUS (publishable) kulcs való ide — az bekerül a csomagolt játékba is,
# a védelmet az adatbázis sor-szintű szabályai (RLS) adják.
# A secret / service_role kulcsot és az adatbázis-jelszót SOHA ne írd ide.

# --- a játék (Electron + Vite) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- a Vercel keep-alive függvény (web/) ---
# Ezeket a Vercel irányítópultján kell megadni (Project -> Settings -> Environment Variables),
# nem a repóban.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Véletlen, hosszú szöveg: a Vercel cron ezt küldi Bearer tokenként, így kívülről nem hívható a végpont.
CRON_SECRET=
